# Copy to .env and paste your Garmin Personal API key after the = (no quotes, no spaces).
# Create the key at https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# Maps (optional). Free key: https://carto.com/basemaps/apikey/
# With only the key set, the Voyager style is used; the URLs let you pick another style.
# Without a key, the map uses OpenStreetMap's own tiles.
# CARTO_API_KEY=
# CARTO_VECTOR_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json?key=YOUR_KEY
# CARTO_RASTER_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_KEY
# CARTO_VECTOR_STYLE_URL_DARK=   (defaults to the matching dark-matter style)

# Optional
# TIME_ZONE=Europe/Berlin   (defaults to your computer's time zone)
# APP_NAME=Splits
# PORT=8000
